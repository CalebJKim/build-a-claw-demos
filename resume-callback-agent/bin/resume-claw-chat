#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_VALUE="$ROOT/src/config-value.js"
cd "$ROOT"

usage() {
  cat <<'USAGE'
Usage:
  resume-claw-chat --resume /path/to/resume.pdf [--target-role "..."] [--location "..."]
  resume-claw-chat --latest-upload [--target-role "..."] [--location "..."]
  resume-claw-chat --latest-upload --async [--target-role "..."] [--location "..."]

Finds an uploaded resume, runs the resume demo pipeline, keeps the report server
running, and prints browser links for the dashboard chat.
USAGE
}

resume=""
target_role=""
location=""
latest_upload=false
async=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --resume)
      resume="${2:-}"
      shift 2
      ;;
    --target-role)
      target_role="${2:-}"
      shift 2
      ;;
    --location)
      location="${2:-}"
      shift 2
      ;;
    --latest-upload)
      latest_upload=true
      shift
      ;;
    --async)
      async=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ "$latest_upload" == true && -z "$resume" ]]; then
  profile="$(node "$CONFIG_VALUE" profile)"
  mapfile -t candidates < <(
    find \
      "$HOME/.openclaw-${profile}/media/inbound" \
      "$HOME/.openclaw-${profile}/media" \
      "$HOME/.openclaw/media/inbound" \
      "$ROOT/workspaces/main/.openclaw/attachments" \
      "$ROOT/workspaces/job-market/.openclaw/attachments" \
      "$ROOT/workspaces/resume-gap/.openclaw/attachments" \
      "$ROOT/workspaces/lead/.openclaw/attachments" \
      "$ROOT/input" \
      "/tmp/openclaw/uploads" \
      -type f \( -iname '*.pdf' -o -iname '*.docx' -o -iname '*.txt' -o -iname '*.md' \) \
      -printf '%T@ %p\n' 2>/dev/null | sort -nr | awk 'NR == 1 {$1=""; sub(/^ /,""); print}'
  )
  resume="${candidates[0]:-}"
fi

if [[ -z "$resume" ]]; then
  echo "No resume path found. Upload a PDF in chat, then run: $ROOT/bin/resume-claw-chat --latest-upload" >&2
  exit 1
fi

if [[ ! -f "$resume" ]]; then
  echo "Resume not found: $resume" >&2
  exit 1
fi

write_status_page() {
  local file="$1"
  local title="$2"
  local body="$3"
  cat > "$file" <<EOF
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="5">
<title>${title}</title>
<style>
body{font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;margin:0;background:#f6f7f9;color:#1f2328}
main{max-width:820px;margin:0 auto;padding:42px 24px;background:#fff;min-height:100vh}
a{color:#0f766e} code,pre{background:#eef2f6;border-radius:6px} code{padding:2px 5px} pre{padding:14px;overflow:auto}
</style>
</head>
<body><main>
${body}
</main></body>
</html>
EOF
}

remote_report_port="$(node "$CONFIG_VALUE" remoteReportPort)"
local_report_port="$(node "$CONFIG_VALUE" localReportPort)"

mkdir -p "$ROOT/.generated"
if [[ -f "$ROOT/.generated/report-server.pid" ]] && kill -0 "$(cat "$ROOT/.generated/report-server.pid")" 2>/dev/null; then
  :
else
  nohup python3 -m http.server "$remote_report_port" --bind 127.0.0.1 > "$ROOT/.generated/report-server.log" 2>&1 &
  echo $! > "$ROOT/.generated/report-server.pid"
  sleep 1
fi

cmd=("$ROOT/bin/resume-claw" run --resume "$resume")
if [[ -n "$target_role" ]]; then
  cmd+=(--target-role "$target_role")
fi
if [[ -n "$location" ]]; then
  cmd+=(--location "$location")
fi

if [[ "$async" == true ]]; then
  job_id="chat-$(date -u +%Y%m%dT%H%M%SZ)"
  job_dir="$ROOT/runs/_jobs/$job_id"
  out_dir="$ROOT/runs/$job_id"
  mkdir -p "$job_dir"
  write_status_page "$job_dir/index.html" "Resume demo running" "<h1>Resume demo running</h1><p>The resume workflow is running in the background.</p><p>This page refreshes every 5 seconds.</p><p><code>$resume</code></p><p>Output directory: <code>$out_dir</code></p>"
  job_cmd=("$ROOT/bin/resume-claw-job" --job-id "$job_id" --resume "$resume")
  if [[ -n "$target_role" ]]; then
    job_cmd+=(--target-role "$target_role")
  fi
  if [[ -n "$location" ]]; then
    job_cmd+=(--location "$location")
  fi
  nohup "${job_cmd[@]}" > "$job_dir/launcher.log" 2>&1 < /dev/null &
  echo $! > "$job_dir/pid"
  cat <<EOF
Resume demo started.
Status: http://127.0.0.1:${local_report_port}/runs/_jobs/${job_id}/index.html
Server-local status: http://127.0.0.1:${remote_report_port}/runs/_jobs/${job_id}/index.html
Output directory: ${out_dir}
EOF
  exit 0
fi

run_log="$ROOT/.generated/chat-run-$(date +%Y%m%d%H%M%S).log"
"${cmd[@]}" | tee "$run_log"

out_dir="$(awk -F'Output: ' '/^Output: / {print $2}' "$run_log" | tail -1)"
if [[ -z "$out_dir" ]]; then
  out_dir="$(ls -td "$ROOT"/runs/* | head -1)"
fi

relative="${out_dir#$ROOT/}"

cat <<EOF

Resume demo complete.
Report: http://127.0.0.1:${local_report_port}/${relative}/index.html
Upgraded resume PDF: http://127.0.0.1:${local_report_port}/${relative}/upgraded-resume.pdf
Server-local report: http://127.0.0.1:${remote_report_port}/${relative}/index.html
Output directory: ${out_dir}
EOF
