#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_VALUE="$ROOT/src/config-value.js"
cd "$ROOT"

job_id=""
run_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --job-id)
      job_id="${2:-}"
      shift 2
      ;;
    *)
      run_args+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$job_id" ]]; then
  echo "Usage: demo-job --job-id <id> [workflow flags]" >&2
  exit 2
fi

demo_name="$(node "$CONFIG_VALUE" name)"
job_dir="$ROOT/runs/_jobs/$job_id"
out_dir="$ROOT/runs/$job_id"
mkdir -p "$job_dir"

write_status_page() {
  local file="$1"
  local title="$2"
  local body="$3"
  cat > "$file" <<EOF
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${title}</title>
<style>
body{font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;margin:0;background:#f6f7f9;color:#1f2328}
main{max-width:860px;margin:0 auto;padding:42px 24px;background:#fff;min-height:100vh}
a{color:#2457d6} code,pre{background:#eef2f6;border-radius:6px} code{padding:2px 5px} pre{padding:14px;overflow:auto;white-space:pre-wrap}
</style>
</head>
<body><main>
${body}
</main></body>
</html>
EOF
}

escape_log() {
  sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

set +e
if [[ "${#run_args[@]}" -eq 0 ]]; then
  "$ROOT/bin/$demo_name" sample --out "$out_dir" > "$job_dir/run.log" 2>&1
else
  "$ROOT/bin/$demo_name" run --out "$out_dir" "${run_args[@]}" > "$job_dir/run.log" 2>&1
fi
status=$?
set -e

if [[ "$status" -eq 0 && -f "$out_dir/index.html" ]]; then
  write_status_page "$job_dir/index.html" "$demo_name complete" "<h1>$demo_name complete</h1><p><a href=\"/runs/$job_id/index.html\">Open report</a></p><p>Output directory: <code>$out_dir</code></p><h2>Run log</h2><pre>$(tail -80 "$job_dir/run.log" | escape_log)</pre>"
else
  write_status_page "$job_dir/index.html" "$demo_name failed" "<h1>$demo_name failed</h1><p>Exit code: <code>$status</code></p><p>Output directory: <code>$out_dir</code></p><h2>Run log</h2><pre>$(tail -120 "$job_dir/run.log" | escape_log)</pre>"
fi

exit "$status"
