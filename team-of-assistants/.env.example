# Local demo
DEMO_TODAY=2026-05-14
DEMO_PROFILE=src/data/demo-profile.json
BOOKING_MODE=dry-run

# Optional lightweight Discord runner in src/discord.js
# Create a Discord bot, enable Message Content Intent, invite it to your server,
# then set the token here. The bot replies when mentioned or when a message
# starts with "!pto".
DISCORD_BOT_TOKEN=
DISCORD_REQUIRE_MENTION=1
DISCORD_TRIGGER_PREFIX=!pto

# NemoClaw onboarding
NVIDIA_API_KEY=
BRAVE_API_KEY=
DISCORD_SERVER_ID=
DISCORD_USER_ID=
DISCORD_REQUIRE_MENTION=1
