#!/usr/bin/env node
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const __filename = fileURLToPath(import.meta.url);
const ROOT = path.resolve(path.dirname(__filename), '..');
const seed = JSON.parse(readFileSync(path.join(ROOT, 'data', 'downtime-clock-seed.json'), 'utf8'));

const [command, machineArg = seed.event.machineId] = process.argv.slice(2);

if (!command || ['-h', '--help', 'help'].includes(command)) {
  console.log('Usage: mock-downtime-clock-data event MACHINE-4');
  console.log('       mock-downtime-clock-data history MACHINE-4');
  process.exit(0);
}

if (![seed.event.machineId, seed.event.displayName, 'Machine 4', 'machine-4'].includes(machineArg)) {
  console.error(`Unknown machine: ${machineArg}`);
  process.exit(2);
}

if (command === 'event') {
  console.log(JSON.stringify(seed, null, 2));
  process.exit(0);
}

if (command === 'history') {
  console.log(JSON.stringify({
    machineId: seed.event.machineId,
    displayName: seed.event.displayName,
    history: seed.history,
  }, null, 2));
  process.exit(0);
}

console.error(`Unknown command: ${command}`);
process.exit(2);
