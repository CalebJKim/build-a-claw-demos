{
  "gateway": {
    "mode": "local",
    "port": "${GATEWAY_PORT}"
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "${OPENCLAW_MODEL}",
        "fallbacks": []
      },
      "workspace": "${DEMO_ROOT}/workspaces/main",
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 4
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "vllm": {
        "baseUrl": "${VLLM_BASE_URL}",
        "apiKey": "VLLM_API_KEY",
        "api": "openai-completions",
        "models": [
          {
            "id": "${VLLM_MODEL}",
            "name": "${VLLM_MODEL}",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 262144,
            "maxTokens": 8192
          }
        ]
      }
    }
  }
}
