      "template": "agents/collector/AGENTS.md",
      "soul": "agents/collector/SOUL.md"
    },
    {
      "id": "correlator",
      "workspace": "workspaces/correlator",
      "agentDir": "openclaw/agents/correlator/agent",
      "template": "agents/correlator/AGENTS.md",
      "soul": "agents/correlator/SOUL.md"
    },
    {
      "id": "narrator",
      "workspace": "workspaces/narrator",
      "agentDir": "openclaw/agents/narrator/agent",
      "template": "agents/narrator/AGENTS.md",
      "soul": "agents/narrator/SOUL.md"
    },
    {
      "id": "recommender",
      "workspace": "workspaces/recommender",
