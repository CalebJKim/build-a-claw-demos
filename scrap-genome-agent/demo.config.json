    "input",
    "workspaces",
    ".generated",
    ".archive",
    "openclaw/agents"
  ],
  "sample": {
    "ask": "We're scrapping too many parts on this geometry. Why.",
    "partFamily": "impeller-housing-G7",
    "lookbackDays": 90
